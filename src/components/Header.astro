---
interface Props {
  currentPage?: string;
}

const { currentPage } = Astro.props;

const navItems = [
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/writing', label: 'Writing' },
];
---

<header class="site-header">
  <a href="/" class="site-logo" aria-label="Tony Burns - Home">
    <svg class="logomark" viewBox="0 0 100 100" aria-hidden="true">
      <g class="logomark-letters" transform="translate(1.8, 30) scale(0.070, -0.070) translate(0, -660)">
        <path d="M178 0V16L282 57V605H131L56 448H40V660H650V448H634L559 605H408V57L511 16V0Z"/>
        <path transform="translate(690, 0)" d="M53 0V16L136 57V603L53 644V660H345Q414 660 469.0 643.5Q524 627 555.5 594.5Q587 562 587 512Q587 461 550.5 418.5Q514 376 445 358Q539 345 592.5 302.0Q646 259 646 192Q646 137 609.5 93.5Q573 50 510.5 25.0Q448 0 369 0ZM306 605H261V366H312Q380 366 418.5 397.0Q457 428 457 483Q457 605 306 605ZM343 315H261V55H350Q425 55 468.0 92.0Q511 129 511 186Q511 252 467.5 283.5Q424 315 343 315Z"/>
      </g>
    </svg>
  </a>
  <nav class="nav-primary" aria-label="Primary">
    <ul class="nav-list">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={currentPage === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
