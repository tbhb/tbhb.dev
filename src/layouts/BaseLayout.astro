---
import '../assets/styles/fonts.css';
import '../assets/styles/base.css';
import '../assets/styles/layout.css';
import '../assets/styles/themes.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
}

const {
  title,
  description = "Software engineer writing about crafting developer tools and interesting problems.",
  currentPage,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="cream" data-mode="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text x='50' y='50' font-size='70' text-anchor='middle' dominant-baseline='central'>TB</text></svg>">
  <link rel="preload" href="/fonts/spectral/spectral-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/spectral/spectral-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/ibm-plex-mono/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <slot name="head" />
  <script is:inline>
    // Inline theme initialization to prevent flash
    (function() {
      var p = localStorage.getItem("theme-palette");
      var m = localStorage.getItem("theme-mode");
      if (p) document.documentElement.dataset.theme = p;
      if (m) {
        document.documentElement.dataset.mode = m;
      } else if (matchMedia("(prefers-color-scheme:dark)").matches) {
        document.documentElement.dataset.mode = "dark";
      }
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>

  <Header currentPage={currentPage} />

  <main id="main" class="main-content">
    <slot />
  </main>

  <Footer />

  <script src="../scripts/theme.js"></script>
</body>
</html>
